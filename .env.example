# --- Obligatorias ---
# Secreto compartido: el mismo valor que pondrás en Vapi (server.secret). Genera uno con:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
VAPI_SECRET=cambia-esto-por-un-secreto-largo

# ID del calendario (Google Calendar > Configuración del calendario > "ID de calendario")
GOOGLE_CALENDAR_ID=tu-correo@gmail.com

# ID del Google Sheet (la parte larga de la URL: docs.google.com/spreadsheets/d/<ID>/edit)
GOOGLE_SHEET_ID=1AbCdEfGhIjKlMnOpQrStUvWxYz

# JSON COMPLETO de la service account en una sola línea, O ese mismo JSON codificado en base64:
#   base64 -w0 service-account.json        (Linux)
#   base64 -i service-account.json         (macOS)
GOOGLE_SERVICE_ACCOUNT_JSON=

# --- Opcionales (valores por defecto mostrados) ---
GOOGLE_SHEET_TAB=Leads
TIMEZONE=America/Mexico_City
BUSINESS_START_HOUR=9
BUSINESS_END_HOUR=18
WORKDAYS=0,1,2,3,4
DEFAULT_DURATION_MINUTES=30
SLOT_STEP_MINUTES=30
MIN_NOTICE_MINUTES=30
